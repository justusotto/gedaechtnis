[
  {
    "id": "adv-a01-add-a",
    "kind": "bash",
    "command": "git -C {VAULT} add -A && git -C {VAULT} commit -m 'x' -- Global/Map.md",
    "expect": "deny",
    "why": "a broad `git add -A` sweeps another lane's in-flight work into your commit",
    "cwd": "{REPO}",
    "session_id": "A",
    "rule": "never `git add -A`"
  },
  {
    "id": "twin-a01-add-path",
    "kind": "bash",
    "command": "git -C {VAULT} add -- Global/Map.md && git -C {VAULT} commit -m 'x' -- Global/Map.md",
    "expect": "allow",
    "why": "the same intent, staged path-limited",
    "cwd": "{REPO}",
    "session_id": "A",
    "twin_of": "adv-a01-add-a"
  },
  {
    "id": "adv-a02-commit-dot",
    "kind": "bash",
    "command": "git -C {VAULT} commit -m 'x' .",
    "expect": "deny",
    "why": "`commit … .` is every tracked change, the exact breadth `add .` is refused for",
    "cwd": "{REPO}",
    "session_id": "A",
    "rule": "breadth"
  },
  {
    "id": "twin-a02-commit-path",
    "kind": "bash",
    "command": "git -C {VAULT} commit -m 'x' -- Global/Map.md",
    "expect": "allow",
    "why": "path-limited to one file",
    "cwd": "{REPO}",
    "session_id": "A",
    "twin_of": "adv-a02-commit-dot"
  },
  {
    "id": "adv-a03-commit-a",
    "kind": "bash",
    "command": "git -C {VAULT} commit -a -m 'x'",
    "expect": "deny",
    "why": "`-a` stages and commits every tracked change with no pathspec",
    "cwd": "{REPO}",
    "session_id": "A",
    "rule": "never `git commit -a`"
  },
  {
    "id": "twin-a03-commit-path",
    "kind": "bash",
    "command": "git -C {VAULT} commit -m 'x' -- Global/Map.md",
    "expect": "allow",
    "why": "path-limited",
    "cwd": "{REPO}",
    "session_id": "A",
    "twin_of": "adv-a03-commit-a"
  },
  {

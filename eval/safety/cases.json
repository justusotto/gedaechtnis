    "kind": "bash",
    "command": "git -C {VAULT} status",
    "expect": "allow",
    "why": "read-only, never refused",
    "cwd": "{REPO}",
    "session_id": "A",
    "twin_of": "adv-a11-clean-f"
  },
  {
    "id": "adv-a12-rm-cached-then-pathspec-drop",
    "kind": "bash",
    "command": "git -C {VAULT} rm --cached -- Global/Map.md && git -C {VAULT} commit -m x -- Global/Map.md",
    "expect": "deny",
    "why": "a pathspec commit after `rm --cached` re-reads the working tree and drops the staged deletion",
    "cwd": "{REPO}",
    "session_id": "A",
    "rule": "DISCARDS the staged deletion"
  },
  {
    "id": "twin-a12-assert-form",
    "kind": "bash",
    "command": "git -C {VAULT} rm --cached -- Global/Map.md; S=$(git -C {VAULT} diff --cached --name-only | sort | tr '\\n' '|'); [ \"$S\" = 'Global/Map.md|' ] || exit 9; git -C {VAULT} commit -F /tmp/m",
    "expect": "allow",
    "why": "the stage -> ASSERT -> commit-with-no-pathspec idiom",
    "cwd": "{REPO}",
    "session_id": "A",
    "twin_of": "adv-a12-rm-cached-then-pathspec-drop"
